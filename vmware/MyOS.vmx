#!/usr/bin/vmware
# VMware configuration for booting TazOS from the built ISO.
#
# Usage
#   1. Build the ISO first:            .\dev.ps1
#      This produces build\myos.iso
#   2. Create the IDE disk image:      .\dev.cmd vmdk
#      This produces vmware\tazos-disk.vmdk (descriptor + 8 MB flat extent)
#   3. Open this file with VMware Workstation Player ("Open a Virtual Machine")
#   4. Power on. It boots from the ISO. The IDE disk at ide0:0 is where
#      Notepad / write / append keep files across reboots.
#
# The relative path below assumes this file stays in the vmware\ folder of the
# repository, with the ISO at ..\build\myos.iso.
.encoding = "UTF-8"

config.version = "8"
virtualHW.version = "19"

displayName = "TazOS - Bare metal x86 kernel"
guestOS = "other"

# 128 MB is plenty: the kernel maps what the multiboot memory map reports and
# uses a 1 MB heap.
memsize = "4096"
numvcpus = "8"

# --- boot media -----------------------------------------------------------
# Boot from the ISO (secondary master). The writable disk is on primary
# master (ide0:0) because the ATA driver only talks to the legacy ports at
# 0x1F0. A SCSI disk would be invisible to it. Generate the VMDK first:
#   python3 tools/genvmdk.py
# or from Windows: .\dev.cmd vmdk
ide0:0.present = "TRUE"
ide0:0.fileName = "tazos-disk.vmdk"
ide0:0.deviceType = "disk"
ide0:0.mode = "persistent"

ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "..\build\myos.iso"
ide1:0.startConnected = "TRUE"

bios.bootDelay = "2000"
bios.forceSetupOnce = "FALSE"

# --- serial port ----------------------------------------------------------
# The kernel mirrors all output to COM1. Capturing it to a file gives a full
# text transcript of the session alongside the video, which is useful for the
# report and survives anything that goes wrong on screen.
#
# Without this the kernel still runs: it probes for a UART at startup and
# silently skips serial output when none answers.
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "myos-serial.log"
serial0.startConnected = "TRUE"
serial0.tryNoRxLoss = "FALSE"

# --- input ----------------------------------------------------------------
# The keyboard driver speaks the legacy PS/2 protocol, which VMware emulates
# regardless of what the host keyboard actually is.
usb.present = "FALSE"
ehci.present = "FALSE"

# --- things this kernel does not have drivers for -------------------------
# Left out deliberately rather than by omission: no network stack, no sound,
# no graphics beyond the framebuffer the SVGA driver already handles.
ethernet0.present = "FALSE"
sound.present = "FALSE"
floppy0.present = "FALSE"

svga.vramSize = "268435456"

tools.syncTime = "FALSE"
msg.autoAnswer = "TRUE"
extendedConfigFile = "MyOS.vmxf"
virtualHW.productCompatibility = "hosted"
vmxstats.filename = "MyOS.scoreboard"
numa.autosize.cookie = "80022"
numa.autosize.vcpu.maxPerVirtualNode = "8"
uuid.bios = "56 4d f2 aa 33 9c 68 a5-f4 ef 93 0c 01 e0 dc 89"
uuid.location = "56 4d f2 aa 33 9c 68 a5-f4 ef 93 0c 01 e0 dc 89"
vmotion.checkpointFBSize = "134217728"
vmotion.checkpointSVGAPrimarySize = "268435456"
vmotion.svga.mobMaxSize = "1073741824"
vmotion.svga.graphicsMemoryKB = "1048576"
monitor.phys_bits_used = "45"
vm.lastPowerRequestTimestamp = "1787561805096000"
cleanShutdown = "TRUE"
softPowerOff = "FALSE"
mks.enable3d = "TRUE"
vmotion.svga.supports3D = "1"
vmotion.svga.baseCapsLevel = "9"
vmotion.svga.maxPointSize = "189"
vmotion.svga.maxTextureSize = "32768"
vmotion.svga.maxVolumeExtent = "16384"
vmotion.svga.maxTextureAnisotropy = "16"
vmotion.svga.lineStipple = "1"
vmotion.svga.dxMaxConstantBuffers = "15"
vmotion.svga.dxProvokingVertex = "1"
vmotion.svga.sm41 = "1"
vmotion.svga.multisample2x = "1"
vmotion.svga.multisample4x = "1"
vmotion.svga.msFullQuality = "1"
vmotion.svga.logicOps = "1"
vmotion.svga.bc67 = "9"
vmotion.svga.sm5 = "1"
vmotion.svga.multisample8x = "1"
vmotion.svga.logicBlendOps = "1"
gui.stretchGuestMode = "fullfill"
gui.enableStretchGuest = "TRUE"
svga.graphicsMemoryKB = "1048576"
ide0:0.redo = ""
cpuid.coresPerSocket = "2"
